; RUN: llc -mtriple=aarch64-linux-gnu -code-model=large -relocation-model=pic -aarch64-min-jump-table-entries=4 -o - %s | FileCheck %s

; The large position-independent code model reaches preemptible symbols through
; the GOT, indexing it with a full 64-bit offset, and reaches local symbols
; directly with a full 64-bit PC-relative displacement. Neither uses ADRP, whose
; +/-4GB range is what the large code model exists to escape.

@preemptible = external global i32
@local = dso_local global i32 0

define i32 @load_preemptible() {
; CHECK-LABEL: load_preemptible:
; CHECK:       // %bb.0:
; CHECK-NEXT:    movz x8, #:gotoff_g0_nc:preemptible
; CHECK-NEXT:  .Ltmp0:
; CHECK-NEXT:    adr x9, .Ltmp0
; CHECK-NEXT:    movz x17, #:prel_g3:_GLOBAL_OFFSET_TABLE_+4
; CHECK-NEXT:    movk x17, #:prel_g2_nc:_GLOBAL_OFFSET_TABLE_+8
; CHECK-NEXT:    movk x17, #:prel_g1_nc:_GLOBAL_OFFSET_TABLE_+12
; CHECK-NEXT:    movk x17, #:prel_g0_nc:_GLOBAL_OFFSET_TABLE_+16
; CHECK-NEXT:    add x9, x9, x17
; CHECK-NEXT:    movk x8, #:gotoff_g1_nc:preemptible
; CHECK-NEXT:    movk x8, #:gotoff_g2_nc:preemptible
; CHECK-NEXT:    movk x8, #:gotoff_g3:preemptible
; CHECK-NEXT:    ldr x8, [x9, x8]
; CHECK-NEXT:    ldr w0, [x8]
; CHECK-NEXT:    ret
  %v = load i32, ptr @preemptible
  ret i32 %v
}

define i32 @load_local() {
; CHECK-LABEL: load_local:
; CHECK:       // %bb.0:
; CHECK-NEXT:  .Ltmp1:
; CHECK-NEXT:    adr x8, .Ltmp1
; CHECK-NEXT:    movz x17, #:prel_g3:.Llocal$local+4
; CHECK-NEXT:    movk x17, #:prel_g2_nc:.Llocal$local+8
; CHECK-NEXT:    movk x17, #:prel_g1_nc:.Llocal$local+12
; CHECK-NEXT:    movk x17, #:prel_g0_nc:.Llocal$local+16
; CHECK-NEXT:    add x8, x8, x17
; CHECK-NEXT:    ldr w0, [x8]
; CHECK-NEXT:    ret
  %v = load i32, ptr @local
  ret i32 %v
}

; The GOT base is a separate node so that repeated GOT accesses in one function
; share a single computation of it.
define i32 @two_got_accesses(ptr %p) {
; CHECK-LABEL: two_got_accesses:

; CHECK-NEXT:    movz x8, #:gotoff_g0_nc:preemptible
; CHECK-NEXT:    movz x9, #:gotoff_g0_nc:other
; CHECK-NEXT:    movk x8, #:gotoff_g1_nc:preemptible
; CHECK-NEXT:    movk x9, #:gotoff_g1_nc:other
; CHECK-NEXT:    movk x8, #:gotoff_g2_nc:preemptible
; CHECK-NEXT:    movk x9, #:gotoff_g2_nc:other
; CHECK-NEXT:    movk x8, #:gotoff_g3:preemptible
; CHECK-NEXT:    movk x9, #:gotoff_g3:other
; CHECK-NEXT:  .Ltmp2:
; CHECK-NEXT:    adr x10, .Ltmp2
; CHECK-NEXT:    movz x17, #:prel_g3:_GLOBAL_OFFSET_TABLE_+4
; CHECK-NEXT:    movk x17, #:prel_g2_nc:_GLOBAL_OFFSET_TABLE_+8
; CHECK-NEXT:    movk x17, #:prel_g1_nc:_GLOBAL_OFFSET_TABLE_+12
; CHECK-NEXT:    movk x17, #:prel_g0_nc:_GLOBAL_OFFSET_TABLE_+16
; CHECK-NEXT:    add x10, x10, x17
; CHECK-NEXT:    ldr x8, [x10, x8]
; CHECK-NEXT:    ldr x9, [x10, x9]
; CHECK-NEXT:    ldr w8, [x8]
; CHECK-NEXT:    ldr w9, [x9]
; CHECK-NEXT:    add w0, w8, w9
; CHECK-NEXT:    ret
  %a = load i32, ptr @preemptible
  %b = load i32, ptr @other
  %s = add i32 %a, %b
  ret i32 %s
}

@other = external global i32

